<mujoco model="safehands_bench">
  <include file="so101/so101_new_calib.xml"/>

  <option timestep="0.002"/>

  <visual>
    <headlight diffuse="0.65 0.65 0.65" ambient="0.35 0.35 0.35" specular="0 0 0"/>
    <global azimuth="150" elevation="-28" offwidth="960" offheight="720"/>
    <quality shadowsize="2048"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.93 0.94 0.96" rgb2="0.75 0.80 0.86" width="256" height="1536"/>
    <texture name="bench" type="2d" builtin="checker" rgb1="0.86 0.84 0.80" rgb2="0.80 0.78 0.74"
             width="512" height="512"/>
    <material name="bench" texture="bench" texrepeat="6 6" reflectance="0.05"/>
    <material name="keepout" rgba="1.0 0.35 0.2 0.22"/>
  </asset>

  <worldbody>
    <light pos="0.2 0 1.2" dir="0 0 -1" directional="true" diffuse="0.5 0.5 0.5"/>
    <geom name="table" type="plane" size="0.6 0.6 0.01" material="bench" contype="1" conaffinity="1"/>

    <!-- Objects the program can use. 25 mm cubes, like LEGO-sized blocks. -->
    <body name="blue_block" pos="0.22 0.08 0.0125">
      <freejoint name="blue_block"/>
      <geom type="box" size="0.0125 0.0125 0.0125" rgba="0.15 0.35 0.9 1" mass="0.01" friction="1.2 0.01 0.001"/>
    </body>
    <body name="red_block" pos="0.24 -0.06 0.0125">
      <freejoint name="red_block"/>
      <geom type="box" size="0.0125 0.0125 0.0125" rgba="0.9 0.15 0.15 1" mass="0.01" friction="1.2 0.01 0.001"/>
    </body>
    <body name="yellow_block" pos="0.16 0.16 0.0125">
      <freejoint name="yellow_block"/>
      <geom type="box" size="0.0125 0.0125 0.0125" rgba="0.95 0.8 0.1 1" mass="0.01" friction="1.2 0.01 0.001"/>
    </body>

    <!-- Green tray outline (visual only). -->
    <body name="tray" pos="0.16 -0.18 0">
      <geom type="box" size="0.05 0.04 0.002" pos="0 0 0.002" rgba="0.2 0.7 0.3 1" contype="0" conaffinity="0"/>
    </body>

    <!-- Where a person's hand is resting on the bench. The arm must never enter this zone.
         The safety checker reads its position and radius from the model, so moving it here moves the rule. -->
    <body name="hand_zone" pos="0.10 0.24 0.06">
      <geom name="hand_zone" type="cylinder" size="0.07 0.06" material="keepout" contype="0" conaffinity="0"/>
    </body>

    <camera name="overview" pos="0.62 0.42 0.42" xyaxes="-0.56 0.83 0 -0.39 -0.26 0.88"/>
  </worldbody>
</mujoco>
